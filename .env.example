# Copy to .env and fill in. Never commit the real .env (it's gitignored).

# OpenAI backend (used by --backend openai, the default once this is set)
OPENAI_API_KEY=
# gpt-5.4-nano (cheapest tier, confirmed via a live `GET /v1/models` call)
# was tried first but measurably underperformed on the extraction/
# classification judgment task -- both false positives (flagged CI-cache/
# test-mocking PRs as real techniques) and a false negative (missed a
# pattern Sonnet caught twice). gpt-5.4-mini, one tier up, is the working
# default -- still cheap, reasons reliably enough for this task.
OPENAI_MODEL=gpt-5.4-mini

# Generic OpenAI-compatible backend (vllm / Azure OpenAI / etc), used by --backend openai-compatible
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=EMPTY
LLM_MODEL_NAME=

# HuggingFace Hub token, only needed to pull an external reference PR-context
# dataset as an additional (not replacement) source -- see docs/pipeline-design.md
HF_TOKEN=
